<Project>
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
	</PropertyGroup>
	<PropertyGroup Condition="'$(MSBuildProjectName)' == 'Edi.TemplateEmail' Or '$(MSBuildProjectName)' == 'Edi.TemplateEmail.Smtp'">
		<Version>2026.8.0</Version>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Company>edi.wang</Company>
		<Authors>Edi Wang</Authors>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://edi.wang</PackageProjectUrl>
		<RepositoryUrl>https://github.com/EdiWang/Edi.TemplateEmail</RepositoryUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<SignAssembly>true</SignAssembly>
		<PackageIcon>edi-logo-blue.png</PackageIcon>
	</PropertyGroup>
	<PropertyGroup Condition="'$(MSBuildProjectName)' == 'Edi.TemplateEmail.Tests' Or '$(MSBuildProjectName)' == 'Edi.TemplateEmail.TestConsole'">
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>
	<ItemGroup Condition="'$(MSBuildProjectName)' == 'Edi.TemplateEmail' Or '$(MSBuildProjectName)' == 'Edi.TemplateEmail.Smtp'">
		<None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
		<None Include="$(MSBuildThisFileDirectory)img\edi-logo-blue.png" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
